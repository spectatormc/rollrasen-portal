# Kopiere diese Datei nach .env und trage deine Werte ein
# cp .env.example .env

PORT=3002

# SMTP – z.B. dein Webhosting-Mailserver
SMTP_HOST=mail.deinedomain.de
SMTP_PORT=587
SMTP_USER=info@gartenbau-kosten.de
SMTP_PASS=dein_passwort

# E-Mail-Adresse, an die Anfragen und Partner-Anfragen geschickt werden
ADMIN_EMAIL=info@gartenbau-kosten.de
